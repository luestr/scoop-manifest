{
    "version": "0.2.0",
    "description": "Fast native Markdown editor and notes workspace",
    "homepage": "https://github.com/sorrycc/Deckle",
    "license": "MIT",
    "notes": [
        "The vendor tarball is used as-is: 'Deckle.exe', the bundled LXGW WenKai fonts and the icon, no installer and no unpack step.",
        "Settings, workspaces and tabs live in '%APPDATA%\\Deckle'. 'updater.json' is seeded with 'automaticChecks: false' on install, so the app never checks for updates in the background; update with 'scoop update deckle'.",
        "No startup entry is registered by the manifest, by the archive or on first run. 'scoop uninstall' also removes any run entry that points into the Scoop directory."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/sorrycc/Deckle/releases/download/v0.2.0/deckle-0.2.0-windows-amd64.tar.gz",
            "hash": "dd4b109c26908709a1837bf3166c1413c1078cd4587c0fcd0f8cc3a40ae97823"
        },
        "arm64": {
            "url": "https://github.com/sorrycc/Deckle/releases/download/v0.2.0/deckle-0.2.0-windows-arm64.tar.gz",
            "hash": "a3d337a5cad0eb3b3c9070bce1938a93d249424f942167da79027aede29a5dab"
        }
    },
    "post_install": [
        "$configDir = Join-Path $env:APPDATA 'Deckle'",
        "$updater = Join-Path $configDir 'updater.json'",
        "if (!(Test-Path -LiteralPath $updater)) {",
        "    New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
        "    [System.IO.File]::WriteAllText($updater, '{\"automaticChecks\": false}', (New-Object System.Text.UTF8Encoding($false)))",
        "}"
    ],
    "shortcuts": [
        [
            "Deckle.exe",
            "Deckle"
        ]
    ],
    "post_uninstall": [
        "$runKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "$key = Get-Item -LiteralPath $runKey -ErrorAction SilentlyContinue",
        "if ($key) {",
        "    foreach ($name in $key.Property) {",
        "        $value = Get-ItemPropertyValue -LiteralPath $runKey -Name $name -ErrorAction SilentlyContinue",
        "        if ($value -like \"*\\apps\\$app\\*\") { Remove-ItemProperty -LiteralPath $runKey -Name $name -Force -ErrorAction SilentlyContinue }",
        "    }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sorrycc/Deckle/releases/download/v$version/deckle-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/sorrycc/Deckle/releases/download/v$version/deckle-$version-windows-arm64.tar.gz"
            }
        }
    }
}
