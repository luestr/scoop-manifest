{
    "version": "0.4.4",
    "description": "Third-party QQ Music client with a native interface, player and desktop lyrics",
    "homepage": "https://github.com/Amamiya23/mygo-qyin",
    "license": "AGPL-3.0-only",
    "notes": [
        "The vendor tarball is used as-is: 'Lilt.exe', its icon and the licence files, no installer and no unpack step.",
        "Settings, the login session and the play cache live in '%APPDATA%\\Lilt'. 'updater.json' is seeded with 'automaticChecks: false' on install, so the app never checks for updates in the background; update with 'scoop update lilt'.",
        "No startup entry is registered by the manifest, by the archive or on first run. 'scoop uninstall' also removes any run entry that points into the Scoop directory."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Amamiya23/mygo-qyin/releases/download/v0.4.4/lilt-0.4.4-windows-amd64.tar.gz",
            "hash": "cf90492d7852861654861e5f169e32f95de9a5f9e0868c1822790e04d1157a1e"
        },
        "arm64": {
            "url": "https://github.com/Amamiya23/mygo-qyin/releases/download/v0.4.4/lilt-0.4.4-windows-arm64.tar.gz",
            "hash": "f46651a2c07d52d2327b8d02359acd2503af6b1855c148058a86a23b0154cbef"
        }
    },
    "post_install": [
        "$configDir = Join-Path $env:APPDATA 'Lilt'",
        "$updater = Join-Path $configDir 'updater.json'",
        "if (!(Test-Path -LiteralPath $updater)) {",
        "    New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
        "    [System.IO.File]::WriteAllText($updater, '{\"automaticChecks\": false}', (New-Object System.Text.UTF8Encoding($false)))",
        "}"
    ],
    "shortcuts": [
        [
            "Lilt.exe",
            "Lilt"
        ]
    ],
    "post_uninstall": [
        "$runKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "$key = Get-Item -LiteralPath $runKey -ErrorAction SilentlyContinue",
        "if ($key) {",
        "    foreach ($name in $key.Property) {",
        "        $value = Get-ItemPropertyValue -LiteralPath $runKey -Name $name -ErrorAction SilentlyContinue",
        "        if ($value -like \"*\\apps\\$app\\*\") { Remove-ItemProperty -LiteralPath $runKey -Name $name -Force -ErrorAction SilentlyContinue }",
        "    }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Amamiya23/mygo-qyin/releases/download/v$version/lilt-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/Amamiya23/mygo-qyin/releases/download/v$version/lilt-$version-windows-arm64.tar.gz"
            }
        },
        "hash": {
            "url": "https://github.com/Amamiya23/mygo-qyin/releases/download/v$version/SHA256SUMS",
            "find": "$basename"
        }
    }
}
