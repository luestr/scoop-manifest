{
    "version": "5.9.3.42398134",
    "description": "AI agent for everyday office work that turns a single sentence into finished reports, decks and spreadsheets",
    "homepage": "https://www.workbuddy.cn",
    "license": "Proprietary",
    "notes": [
        "The vendor ships an NSIS installer that repacks the Electron payload into a fresh temp folder on every start, so this manifest extracts the payload once during install and launches the real executable instead. Startup is therefore as fast as a regular install.",
        "Settings, sessions and logs live in '%USERPROFILE%\\.workbuddy' and survive updates, so 'scoop update' keeps your data. Prefer 'scoop update workbuddy-cn' over the in-app updater so Scoop keeps managing the installation."
    ],
    "depends": "7zip",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.codebuddy.cn/workbuddy/saas/win32-x64-user/WorkBuddy-win32-x64-user-5.9.3.42398134-d4692421.exe",
            "hash": "b5edb52bd6c5b6c7296cf2fff697b019c86d11992a8a814c3010d611896852f9"
        }
    },
    "pre_install": [
        "$wrapper = Get-Item \"$dir\\$fname\"",
        "$stage = Join-Path $env:TEMP ('workbuddy-' + $PID)",
        "if (Test-Path $stage) { Remove-Item -Recurse -Force $stage }",
        "New-Item -ItemType Directory -Path $stage | Out-Null",
        "& 7z x $wrapper.FullName \"-o$stage\" -y | Out-Null",
        "$inner = Get-ChildItem -Path $stage -Recurse -Filter 'app-*.7z' | Select-Object -First 1",
        "if ($null -eq $inner) { throw 'Inner app archive (app-*.7z) not found inside the NSIS wrapper' }",
        "& 7z x $inner.FullName \"-o$dir\" -y | Out-Null",
        "$overlay = Join-Path $stage 'resources'",
        "if (Test-Path $overlay) { Copy-Item -Path $overlay -Destination $dir -Recurse -Force }",
        "Remove-Item -Recurse -Force $stage",
        "Remove-Item -Force $wrapper.FullName"
    ],
    "shortcuts": [
        [
            "WorkBuddy.exe",
            "WorkBuddy"
        ]
    ],
    "checkver": {
        "url": "https://www.workbuddy.cn/v2/update?platform=workbuddy-win32-x64-user",
        "jsonpath": "$.url",
        "regex": "WorkBuddy-win32-x64-user-(?<version>[\\d.]+)-(?<build>[0-9a-f]+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.codebuddy.cn/workbuddy/saas/win32-x64-user/WorkBuddy-win32-x64-user-$version-$matchBuild.exe"
            }
        },
        "hash": {
            "url": "https://www.workbuddy.cn/v2/update?platform=workbuddy-win32-x64-user",
            "jsonpath": "$.sha256hash"
        }
    }
}
