{
    "version": "2.1.10",
    "description": "Desktop AI workspace for chatting with multiple model providers, running agents and managing a local knowledge base",
    "homepage": "https://cherry-ai.com",
    "license": "AGPL-3.0-or-later",
    "notes": [
        "The portable launcher unpacks ~290 MB into a fresh temp folder on every start, so this manifest extracts the payload once during install and runs the real executable instead. Startup is therefore as fast as a regular install.",
        "User data lives in the persisted 'data' folder and survives updates. In-app updates are disabled in portable mode, so update Cherry Studio with 'scoop update cherry-studio'."
    ],
    "depends": "7zip",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.1.10/Cherry-Studio-2.1.10-win-x64-portable.exe",
            "hash": "78d5ca9befa5a479292e8735de4cf07046e3af659cabd77987fcd62f11d06da0"
        },
        "arm64": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.1.10/Cherry-Studio-2.1.10-win-arm64-portable.exe",
            "hash": "e05a09b009ccee5230ba897100936279f994ce77f3296b93a719040acb8bdd33"
        }
    },
    "pre_install": [
        "$wrapper = Get-Item \"$dir\\$fname\"",
        "$stage = Join-Path $env:TEMP (\"cherry-studio-\" + $PID)",
        "if (Test-Path $stage) { Remove-Item -Recurse -Force $stage }",
        "New-Item -ItemType Directory -Path $stage | Out-Null",
        "& 7z e $wrapper.FullName -ir!'app-*.7z' -o\"$stage\" -y | Out-Null",
        "$inner = Get-ChildItem -Path $stage -Filter 'app-*.7z' | Select-Object -First 1",
        "if ($null -eq $inner) { throw 'Inner app archive (app-*.7z) not found inside the NSIS wrapper' }",
        "& 7z x $inner.FullName -o\"$dir\" -y | Out-Null",
        "Remove-Item -Recurse -Force $stage",
        "Remove-Item -Force $wrapper.FullName"
    ],
    "env_set": {
        "PORTABLE_EXECUTABLE_DIR": "$dir"
    },
    "shortcuts": [
        [
            "Cherry Studio.exe",
            "Cherry Studio"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/CherryHQ/cherry-studio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v$version/Cherry-Studio-$version-win-x64-portable.exe"
            },
            "arm64": {
                "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v$version/Cherry-Studio-$version-win-arm64-portable.exe"
            }
        }
    }
}
