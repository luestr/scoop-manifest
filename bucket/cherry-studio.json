{
    "version": "2.1.10",
    "description": "Desktop AI workspace for chatting with multiple model providers, running agents and managing a local knowledge base",
    "homepage": "https://cherry-ai.com",
    "license": "AGPL-3.0-only",
    "notes": [
        "The vendor's NSIS installer is unpacked during install instead of being run, so the payload is laid out once and the app starts directly from the Scoop directory.",
        "User data lives in the persisted 'data' folder and survives updates. The built-in updater is inactive in this layout, so update Cherry Studio with 'scoop update cherry-studio'."
    ],
    "depends": "7zip",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.1.10/Cherry-Studio-2.1.10-win-x64-setup.exe",
            "hash": "f0c56cb51f711fe3983c802acbef52f75fb3ec22820637f4760bd4d218ab82bf"
        },
        "arm64": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.1.10/Cherry-Studio-2.1.10-win-arm64-setup.exe",
            "hash": "6d2bdbad9a47172d8b0949d1e209ecd616125cd5ee78fd00aa71443e32f812c3"
        }
    },
    "pre_install": [
        "$wrapper = Get-Item \"$dir\\$fname\"",
        "$stage = Join-Path $env:TEMP (\"cherry-studio-\" + $PID)",
        "try {",
        "    if (Test-Path $stage) { Remove-Item -Recurse -Force $stage }",
        "    New-Item -ItemType Directory -Path $stage | Out-Null",
        "    & 7z e $wrapper.FullName -ir!'app-*.7z' -o\"$stage\" -y | Out-Null",
        "    if ($LASTEXITCODE -gt 1) { throw \"Failed to unpack the NSIS installer (7z exit code $LASTEXITCODE).\" }",
        "    $inner = Get-ChildItem -Path $stage -Filter 'app-*.7z' | Select-Object -First 1",
        "    if ($null -eq $inner) { throw 'Inner app archive (app-*.7z) not found inside the NSIS installer' }",
        "    & 7z x $inner.FullName -o\"$dir\" -y | Out-Null",
        "    if ($LASTEXITCODE -gt 1) { throw \"Failed to unpack the inner app archive (7z exit code $LASTEXITCODE).\" }",
        "} finally {",
        "    if (Test-Path $stage) { Remove-Item -Recurse -Force $stage }",
        "}",
        "Remove-Item -Force $wrapper.FullName"
    ],
    "env_set": {
        "PORTABLE_EXECUTABLE_DIR": "$dir"
    },
    "shortcuts": [
        [
            "Cherry Studio.exe",
            "Cherry Studio"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/CherryHQ/cherry-studio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v$version/Cherry-Studio-$version-win-x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v$version/Cherry-Studio-$version-win-arm64-setup.exe"
            }
        }
    }
}
