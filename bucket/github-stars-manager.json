{
    "version": "0.8.9",
    "description": "AI-powered manager for GitHub starred repositories with semantic search, auto-categorization and release tracking",
    "homepage": "https://github.com/AmintaCCCP/GithubStarsManager",
    "license": "MIT",
    "notes": "Your stars, settings and AI credentials are kept in '%APPDATA%\\github-stars-manager'.",
    "depends": "7zip",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AmintaCCCP/GithubStarsManager/releases/download/v0.8.9/GitHub.Stars.Manager.Setup.0.8.9.exe",
            "hash": "1bf3248c9e30dd6fa1cf01342e76eb2cf335f9396bb9c651083a5baa1ac6146a"
        }
    },
    "pre_install": [
        "$nsis = Join-Path $dir $fname",
        "$stage = Join-Path $env:TEMP ('github-stars-manager-' + $PID)",
        "Remove-Item $stage -Recurse -Force -ErrorAction SilentlyContinue",
        "New-Item -ItemType Directory -Path $stage | Out-Null",
        "& 7z x \"$nsis\" \"-o$stage\" -y '$PLUGINSDIR\\*.7z' | Out-Null",
        "if ($LASTEXITCODE -gt 1) { throw \"Failed to unpack the NSIS payload (7z exit code $LASTEXITCODE).\" }",
        "$inner = Get-ChildItem $stage -Recurse -Filter 'app-*.7z' | Select-Object -First 1",
        "if (!$inner) { throw 'Inner app archive (app-*.7z) was not found in the NSIS payload.' }",
        "& 7z x \"$($inner.FullName)\" \"-o$dir\" -y | Out-Null",
        "if ($LASTEXITCODE -gt 1) { throw \"Failed to unpack the inner app archive (7z exit code $LASTEXITCODE).\" }",
        "Remove-Item $stage -Recurse -Force",
        "Remove-Item $nsis -Force"
    ],
    "shortcuts": [
        [
            "GitHub Stars Manager.exe",
            "GitHub Stars Manager"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AmintaCCCP/GithubStarsManager/releases/download/v$version/GitHub.Stars.Manager.Setup.$version.exe"
            }
        }
    }
}
